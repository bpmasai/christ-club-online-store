# ==============================================================================
# CHRIST CLUB ONLINE STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local laptop testing:
#   copy .env.example .env.local
#
# On EC2 instances, copy this to .env and configure with your RDS & S3 details.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Amazon RDS PostgreSQL)
# ------------------------------------------------------------------------------
# For AWS EC2 deployment (connecting to your private RDS PostgreSQL):
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public
# Example:
# DATABASE_URL="postgresql://postgres:MySecurePass123@christ-club-db.c123456789.us-east-1.rds.amazonaws.com:5432/christclub?schema=public"
#
# For Local Laptop Development (Simulated or Local Postgres):
# If testing without PostgreSQL installed, leave empty or set to local fallback:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/christclub?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION METADATA & EC2 IDENTITY
# ------------------------------------------------------------------------------
# On AWS EC2: The application automatically calls AWS IMDSv2 (169.254.169.254)
# to fetch the real EC2 Instance ID (e.g. i-0abcd1234ef567890) and Availability Zone.
#
# On your local laptop: Set a custom identifier or leave commented to use laptop hostname:
INSTANCE_ID="local-laptop-node-01"
APP_VERSION="1.0.0"
NODE_ENV="development"
PORT=3000

# ------------------------------------------------------------------------------
# 3. EBS BLOCK STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# On AWS EC2 (Instance A): Set to the directory where your formatted gp3 EBS volume is mounted:
# EBS_MOUNT_PATH="/mnt/demo-ebs"
#
# On Local Laptop: Points to a local test directory:
EBS_MOUNT_PATH="./data/ebs-mount"

# ------------------------------------------------------------------------------
# 4. S3 OBJECT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# On AWS EC2: The EC2 instance automatically gets credentials from its IAM Role.
# You only need to specify your S3 bucket name and region:
S3_BUCKET_NAME="christ-club-store-storage-demo"
AWS_REGION="us-east-1"

# On Local Laptop: Set to "true" to test file operations locally without needing AWS credentials:
MOCK_S3_LOCAL="true"
